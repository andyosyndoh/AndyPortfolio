{
  "name": "Andy",
  "version": "1.5.0",
  "description": "An elegant responsive bootstrap 4.x theme.",
  "author": "andyosyndoh",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build && python3 serve.py",
    "build": "node scripts/build.mjs",
    "serve": "python3 serve.py",
    "serve-simple": "python3 serve.py",
    "sass": "sass --no-source-map assets/scss/johndoe.scss assets/css/johndoe.css",
    "test": "python3 -m unittest discover -s tests",
    "netlify-build": "npm run build"
  },
  "devDependencies": {
    "sass": "^1.93.2"
  },
  "browserslist": [
    "> 1%",
    "ie >= 8",
    "edge >= 15",
    "ie_mob >= 10",
    "ff >= 45",
    "chrome >= 45",
    "safari >= 7",
    "opera >= 23",
    "ios >= 7",
    "android >= 4"
  ],
  "dependencies": {
    "jquery": "3.7.1",
    "bootstrap": "5.3.8",
    "isotope-layout": "3.0.6"
  },
  "engines": {
    "node": ">=22"
  }
}
